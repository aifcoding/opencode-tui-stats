{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-tui-stats",
  "version": "0.4.8",
  "description": "OpenCode 1 TUI plugin that shows live TPS, average TPS, and average time to first token in the session prompt.",
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "engines": {
    "opencode": ">=1.3.14"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=browser --preload @opentui/solid/preload"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.3",
    "@opentui/core": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.32",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist/",
    "README.md",
    "assets/"
  ]
}
