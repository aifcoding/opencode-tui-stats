{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-tui-stats",
  "version": "0.6.0",
  "description": "OpenCode 2 TUI plugin: live TPS/TTFT panel plus quoting previous messages.",
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "engines": {
    "opencode": ">=2.0.0"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=browser --preload @opentui/solid/preload"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "2.2.1",
    "@opencode/plugin": "2.2.1",
    "@opencode/theme": "2.2.1",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist/",
    "README.md",
    "assets/"
  ]
}
